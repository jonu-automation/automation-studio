# Environment reference for Automation Studio
# pnpm local sets local mode, ports and database paths automatically.
# No .env file or provider account is required for the local portfolio demo.
# These values are documentation; provide optional values in the launching
# terminal or in your hosting environment. Do not commit real secrets.

# Optional local AI generator (provider charges may apply).
OPENAI_API_KEY=
LOG_LEVEL=info

# Hosted deployment reference: not a validated production setup.
# LOCAL_MODE must remain false for public hosting.
LOCAL_MODE=false
NODE_ENV=production
PORT=8080
DATABASE_URL=
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PROXY_URL=

# Required outside local mode when storing encrypted credentials.
# Provide a random 64-character hexadecimal key and back it up securely.
CREDENTIAL_ENCRYPTION_KEY=

# Optional billing configuration; billing is disabled in local mode.
# Production billing requires separate testing and configuration.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_HOBBY_VARIANT_ID=
LEMONSQUEEZY_PRO_VARIANT_ID=
LEMONSQUEEZY_TEAM_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
